# Port the backend listens on
PORT=8787

# Comma-separated list of origins allowed to call this API.
# The Vite dev server runs on :3000 by default.
CORS_ORIGIN=http://localhost:3000

# TheSportsDB free tier test key is "3" (low rate limit, no signup).
# Get a real key at https://www.thesportsdb.com/api.php for production use
# and put it here instead.
THESPORTSDB_KEY=3

# How long (ms) each sport's live data is cached before we re-fetch upstream.
# Keeps us under free-tier rate limits and makes tab-switching instant.
CACHE_TTL_MS=45000
